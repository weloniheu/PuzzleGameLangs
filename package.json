{
  "name": "language-puzzle-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "npm run build && electron .",
    "electron:package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "io.github.weloniheu.slime",
    "productName": "SLIME",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.puzzle-games",
      "target": [{ "target": "dir", "arch": ["universal"] }]
    },
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }]
    }
  }
}
