              "autoAdvance": false
            },
            {
              "id": "gtut-4",
              "speaker": "narrator",
              "text": "Pushed something into a corner? U undoes a push · R resets the room.",
              "trigger": "guided_tutorial",
              "autoAdvance": false
            }
          ],
          "hints": [
            {
              "text": "Walk into a word to shove it. Words slide one cell at a time, and U undoes a push.",
              "tag": "step:1"
            },
            {
              "text": "The dashed boxes are the frame. 'who?' takes the doer; 'does what?' takes the action.",
              "tag": "step:2"
            },
            {
              "text": "Push 'the slime' into the who? box and 'hops' into the does what? box.",
              "tag": "step:3"
