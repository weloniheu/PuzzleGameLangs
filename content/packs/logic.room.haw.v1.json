    {
      "id": "logic-haw-003",
      "schema_version": "1.0.0",
      "language": "haw",
      "puzzle_type": "logic_rules",
      "validator_type": "exact_match",
      "difficulty": 4,
      "prompt": "___ KA HAE — finish the rule that wins.",
      "payload": {
        "pack_url": "/content/packs/logic.rules.haw.v1.json",
        "board_id": "haw-03-lanakila",
        "dialogue": {
          "speakers": {},
          "on_enter": [
            {
              "id": "logic-haw-003-enter",
              "speaker": "narrator",
              "text": "KA HAE is written down — but nothing yet says what it does.",
              "trigger": "on_enter"
            }
          ],
          "hints": [
            {
              "text": "Touching the hae does nothing: no rule says it wins.",
              "tag": "step:1"
            },
            {
              "text": "Hawaiian rules name the STATE first, so the missing word goes IN FRONT of ka hae, not after it.",
              "tag": "step:2"
            },
            {
              "text": "Push LANAKILA into the empty cell before KA HAE, then go touch the flag.",
              "tag": "step:3"
            }
          ]
        }
      },
      "solution": {
        "note": "win conditions live in the logic pack's boards"
      },
