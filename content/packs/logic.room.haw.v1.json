      "difficulty": 1,
      "prompt": "Nā rule ma ka ʻōlelo Hawaiʻi — predicate first.",
      "payload": {
        "pack_url": "/content/packs/logic.rules.haw.v1.json",
        "board_id": "haw-00-e-hele",
        "dialogue": {
          "speakers": {},
          "on_enter": [
            {
              "id": "logic-haw-000-enter",
              "speaker": "narrator",
              "text": "The rules here are ʻōlelo Hawaiʻi — and they name the state before the thing.",
              "trigger": "on_enter"
            }
          ],
          "hints": [
            {
              "text": "These sentences put the STATE first and the THING second — the reverse of the English rooms.",
              "tag": "step:1"
            },
            {
              "text": "ʻO ʻOE KA LIMU = 'you are the slime'. LANAKILA KA HAE = 'the flag wins'.",
              "tag": "step:2"
            },
            {
              "text": "Walk right onto the hae (the flag).",
              "tag": "step:3"
            }
          ]
        }
      },
      "solution": {
        "note": "win conditions live in the logic pack's boards"
      },
