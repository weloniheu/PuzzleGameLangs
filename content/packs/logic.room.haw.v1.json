    {
      "id": "logic-haw-001",
      "schema_version": "1.0.0",
      "language": "haw",
      "puzzle_type": "logic_rules",
      "validator_type": "exact_match",
      "difficulty": 2,
      "prompt": "PAHU KA PŌHAKU — but a careless push jams it.",
      "payload": {
        "pack_url": "/content/packs/logic.rules.haw.v1.json",
        "board_id": "haw-01-ke-ala",
        "dialogue": {
          "speakers": {},
          "on_enter": [
            {
              "id": "logic-haw-001-enter",
              "speaker": "narrator",
              "text": "PAHU KA PŌHAKU. It moves — but only where you aim it.",
              "trigger": "on_enter"
            }
          ],
          "hints": [
            {
              "text": "PAHU KA PŌHAKU means 'the rock is push'. PAʻA KA PĀ means 'the wall is solid'.",
              "tag": "step:1"
            },
            {
              "text": "Drive the pōhaku straight down the corridor and it wedges on the hae. Aim it somewhere else.",
              "tag": "step:2"
            },
            {
              "text": "Come at it from below and shove it UP into the pocket, then take the corridor clean.",
              "tag": "step:3"
            }
          ]
        }
      },
      "solution": {
        "note": "win conditions live in the logic pack's boards"
      },
