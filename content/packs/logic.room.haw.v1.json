    {
      "id": "logic-haw-002",
      "schema_version": "1.0.0",
      "language": "haw",
      "puzzle_type": "logic_rules",
      "validator_type": "exact_match",
      "difficulty": 3,
      "prompt": "PAʻA KA PĀ — unless the words come apart.",
      "payload": {
        "pack_url": "/content/packs/logic.rules.haw.v1.json",
        "board_id": "haw-02-wawahi",
        "dialogue": {
          "speakers": {},
          "on_enter": [
            {
              "id": "logic-haw-002-enter",
              "speaker": "narrator",
              "text": "PAʻA KA PĀ. Solid — for exactly as long as those words stay in a row.",
              "trigger": "on_enter"
            }
          ],
          "hints": [
            {
              "text": "There is no gap in the pā (wall). Walking will not solve this one.",
              "tag": "step:1"
            },
            {
              "text": "PAʻA KA PĀ is written on the floor, and written words are objects you can shove.",
              "tag": "step:2"
            },
            {
              "text": "Push any one of the three words out of its line. The pā stops being paʻa; then walk to the hae.",
              "tag": "step:3"
            }
          ]
        }
      },
      "solution": {
        "note": "win conditions live in the logic pack's boards"
      },
